# ==============================================================================
# 🦀 Rust / Cargo Build Artifacts
# ==============================================================================
# Matches root target/ and any crates/*/target/.
target/

# Per-crate Cargo.lock files for workspace members — root Cargo.lock is canonical.
**/Cargo.lock
!Cargo.lock

# ==============================================================================
# 🍞 JS / Bun / Svelte Frontend Build Artifacts
# ==============================================================================
# Third-party dependency directories (Crucial to ignore!)
node_modules/
jspm_packages/

# Vite production build output
dist/
dist-ssr/

# Log files generated by JS package managers
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# TypeScript incremental compilation cache
*.tsbuildinfo

# ==============================================================================
# 🔒 Environment Secrets & Configuration
# ==============================================================================
.env
.env.*
!.env.example

# The platform's single source of configuration truth is `config.toml`.
# Only `config.default.toml` is the template (tracked); runtime `config.toml` is local-only.
config.toml
# v11.6 crash recovery: last-good backup + atomic-write temp + corrupt quarantine
config.toml.bak
config.toml.tmp
config.toml.corrupt-*


# ==============================================================================
# 🗄️ Local Databases & Data Directories
# ==============================================================================
# SQLite telemetry files (anywhere in the tree)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
telemetry.db
telemetry.db-shm
telemetry.db-wal
*.backup*
*.backup-*

# Docker postgres volume data (if used in future phases)
postgres_data/

# ==============================================================================
# 🖥️ System & Editor Specific Files
# ==============================================================================
# OS Files
.DS_Store
Thumbs.db

# VS Code / IntelliJ settings
.vscode/
.idea/

# opencode workspace metadata (plans, local agent state)
.opencode/

# Editor temp files
*.swp

# Application Log files
*.log

# Compiled Binary executables/libraries
*.exe
*.dll
*.so
*.dylib

# Engine PID file (written by manage.sh)
.engine.pid

# Smart-port resolved endpoint (v11.3, written by the daemon on boot)
.server.port


# ==============================================================================
# 🧪 E2E harness artifacts (written by ./manage.sh e2e-backtest)
# ==============================================================================
.e2e-*
e2e-backtest-report.*
e2e-matrix.log
rust_out

# ==============================================================================
# 📊 Data-Science export tree (./ds/ at any level — web + CLI backtest artifacts)
# ==============================================================================
ds/

# ==============================================================================
# 📸 Snapshot-export tree (periodic per-tab JSON dumps for offline inspection)
# ==============================================================================
snapshots/

# Multi-session experiment folders (per-folder configs + results)
experiments/
